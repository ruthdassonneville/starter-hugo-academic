author = {Ruth Dassonneville and Patrick Fournier and Zeynep Somer-Topcu},
title ={Do Citizens Perceive an empty Left-Authoritarian Quadrant? Citizen Perceptions of Parties’ Positions in a Multi-Dimensional Space},

